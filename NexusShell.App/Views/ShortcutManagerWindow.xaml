<Window x:Class="NexusShell.App.Views.ShortcutManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:ShortcutManagerViewModel, IsDesignTimeCreatable=False}"
        Title="Shortcut Manager" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White"
        AutomationProperties.Name="Shortcut Manager Window"
        AutomationProperties.HelpText="Manage application keyboard shortcuts from this window.">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Keyboard Shortcuts" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"
                   AutomationProperties.HeadingLevel="Level1"/>

        <!-- Accessible List View -->
        <ListView x:Name="ShortcutsListView"
                  Grid.Row="1" 
                  ItemsSource="{Binding Shortcuts}" 
                  SelectedItem="{Binding SelectedShortcut}"
                  Background="#2D2D2D"
                  BorderThickness="1"
                  BorderBrush="#444"
                  Foreground="White"
                  FontSize="14"
                  AutomationProperties.Name="Shortcuts List"
                  AutomationProperties.HelpText="List of current keyboard shortcuts. Use arrow keys to navigate.">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Command" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CommandName}" Padding="5"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Key Combination" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayString}" Padding="5" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="AutomationProperties.Name">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0} assigned to {1}">
                                <Binding Path="CommandName"/>
                                <Binding Path="DisplayString"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="_Add" 
                    Command="{Binding AddShortcutCommand}" 
                    Width="80" 
                    Margin="0,0,10,0"
                    AutomationProperties.Name="Add Shortcut"
                    AutomationProperties.HelpText="Create a new keyboard shortcut"/>
            
            <Button Content="_Edit" 
                    Command="{Binding EditShortcutCommand}" 
                    CommandParameter="{Binding ElementName=ShortcutsListView, Path=SelectedItem}"
                    Width="80" 
                    Margin="0,0,10,0"
                    AutomationProperties.Name="Edit Shortcut"
                    AutomationProperties.HelpText="Edit the selected shortcut"/>
            
            <Button Content="_Delete" 
                    Command="{Binding DeleteShortcutCommand}" 
                    CommandParameter="{Binding ElementName=ShortcutsListView, Path=SelectedItem}"
                    Width="80" 
                    Margin="0,0,10,0"
                    AutomationProperties.Name="Delete Shortcut"
                    AutomationProperties.HelpText="Remove the selected shortcut"/>

            <Button Content="_Import" 
                    Command="{Binding ImportShortcutsCommand}" 
                    Width="80" 
                    Margin="0,0,10,0"
                    AutomationProperties.Name="Import Shortcuts"
                    AutomationProperties.HelpText="Import shortcuts from a file"/>

            <Button Content="_Export" 
                    Command="{Binding ExportShortcutsCommand}" 
                    Width="80" 
                    Margin="0,0,10,0"
                    AutomationProperties.Name="Export Shortcuts"
                    AutomationProperties.HelpText="Export shortcuts to a file"/>
            
            <Button Content="_Reset Defaults" 
                    Command="{Binding ResetDefaultsCommand}" 
                    Width="110" 
                    AutomationProperties.Name="Reset to Defaults"
                    AutomationProperties.HelpText="Restore default keyboard shortcuts"/>
        </StackPanel>
    </Grid>
</Window>