<Window x:Class="NexusShell.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        xmlns:helpers="clr-namespace:NexusShell.App.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="Settings" Height="680" Width="800"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        AutomationProperties.Name="Settings Window"
        FocusManager.FocusedElement="{Binding ElementName=CategoryList}">
    
    <Window.Resources>
        <helpers:EqualValueToVisibilityConverter x:Key="EqualValueToVisibilityConverter" />
        
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3F3F46" />
                    <Setter Property="Foreground" Value="#007ACC" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="NexusShell Settings" FontSize="24" FontWeight="Bold" Foreground="White" 
                   Margin="20,20,20,10" AutomationProperties.HeadingLevel="Level1" />

        <!-- Categories List -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="10,0,0,10">
            <Label Content="Categories" Foreground="#888" FontSize="12" DockPanel.Dock="Top" Margin="10,0,0,5" />
            <ListBox x:Name="CategoryList"
                     ItemsSource="{Binding AvailableCategories}"
                     SelectedItem="{Binding SelectedCategory}"
                     ItemContainerStyle="{StaticResource CategoryItemStyle}"
                     Background="#252526"
                     BorderBrush="#333"
                     BorderThickness="1"
                     AutomationProperties.Name="Settings Categories"
                     AutomationProperties.HelpText="Use up and down arrows to switch between setting categories.">
            </ListBox>
        </DockPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,10">
            <StackPanel>
                
                <!-- ── General Category ──────────────────────────────────────── -->
                <StackPanel x:Name="GeneralPanel" Visibility="{Binding SelectedCategory, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=General}">
                    <TextBlock Text="General Settings" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20" />
                    
                    <Label Target="{Binding ElementName=ProfileList}" Content="Default Shell Profile" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                    <ListBox x:Name="ProfileList"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             Margin="0,5,0,20"
                             Background="Transparent"
                             BorderThickness="0"
                             AutomationProperties.Name="Default Shell Profile List">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Profiles"
                                             Content="{Binding Name}"
                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Foreground="White"
                                             FontSize="14"
                                             Padding="5"
                                             AutomationProperties.Name="{Binding Name}"
                                             AutomationProperties.HelpText="Select this profile as default"/>     
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Label Target="{Binding ElementName=DisplayModeCombo}" Content="Display Mode" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                    <ComboBox x:Name="DisplayModeCombo"
                              ItemsSource="{Binding DisplayModes}"
                              SelectedItem="{Binding SelectedDisplayMode}"
                              Margin="0,5,0,10"
                              AutomationProperties.Name="Display Mode Selection"
                              AutomationProperties.HelpText="Choose how terminal output is displayed"/>
                </StackPanel>

                <!-- ── Appearance Category ───────────────────────────────────── -->
                <StackPanel x:Name="AppearancePanel" Visibility="{Binding SelectedCategory, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=Appearance}">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20" />

                    <Label Target="{Binding ElementName=FontCombo}" Content="Font Family" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                    <ComboBox x:Name="FontCombo"
                              ItemsSource="{Binding Fonts}"
                              SelectedItem="{Binding FontFamily}"
                              Margin="0,5,0,10"
                              AutomationProperties.Name="Font Family Selection" />

                    <Label Target="{Binding ElementName=FontSizeSlider}" Content="Font Size" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                    <Slider x:Name="FontSizeSlider"
                            Minimum="8" Maximum="36"
                            Value="{Binding FontSize}"
                            Margin="0,5,0,10"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Font Size Adjustment"
                            AutomationProperties.HelpText="Use Left/Right arrows to adjust size"/>
                </StackPanel>

                <!-- ── Integration Category ──────────────────────────────────── -->
                <StackPanel x:Name="IntegrationPanel" Visibility="{Binding SelectedCategory, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=Integration}">
                    <TextBlock Text="System Integration &amp; Behavior" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20" />

                    <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates automatically on startup"
                              IsChecked="{Binding AutoCheckUpdates}"
                              Foreground="White" Margin="0,5,0,10"
                              AutomationProperties.Name="Auto Update Check Toggle"/>

                    <CheckBox Content="Run NexusShell on Windows Startup"
                              IsChecked="{Binding RunOnStartup}"
                              Foreground="White" Margin="0,5,0,10"
                              AutomationProperties.Name="Run on Startup Toggle"/>

                    <CheckBox Content="Add 'Open with NexusShell' to context menu"
                              IsChecked="{Binding IsRegistered, Mode=OneWay}"
                              Command="{Binding ToggleRegistrationCommand}"
                              Foreground="White" Margin="0,5,0,10"
                              AutomationProperties.Name="Register in Context Menu"/>

                    <Separator Margin="0,10" Background="#444" />

                    <CheckBox Content="Enable Command Suggestions"
                              IsChecked="{Binding EnableSuggestions}"
                              Foreground="White" Margin="0,5,0,10"
                              AutomationProperties.Name="Enable Suggestions Toggle"/>

                    <CheckBox Content="Show shell startup header (Warning/Copyright)"
                              IsChecked="{Binding ShowShellHeader}"
                              Foreground="White" Margin="0,5,0,10"
                              AutomationProperties.Name="Show Startup Header Toggle"/>

                    <Separator Margin="0,10" Background="#444" />

                    <TextBlock Text="Sound Effects" FontWeight="Bold" Foreground="White" Margin="0,5" AutomationProperties.HeadingLevel="Level2"/>

                    <CheckBox Content="Enable UI sound effects (typing, commands, windows)"
                              IsChecked="{Binding EnableSoundEffects}"
                              Foreground="White" Margin="0,5,0,10"
                              AutomationProperties.Name="Enable Sound Effects Toggle"/>

                    <Label Target="{Binding ElementName=SoundVolumeSlider}" Content="Sound Effects Volume" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                    <Slider x:Name="SoundVolumeSlider"
                            Minimum="0" Maximum="1"
                            Value="{Binding SoundEffectsVolume}"
                            IsEnabled="{Binding EnableSoundEffects}"
                            Margin="0,5,0,10"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Sound Effects Volume"
                            AutomationProperties.HelpText="Use Left/Right arrows to adjust the volume of UI sound effects."/>

                    <Separator Margin="0,10" Background="#444" />

                    <TextBlock Text="Visual Effects" FontWeight="Bold" Foreground="White" Margin="0,5" AutomationProperties.HeadingLevel="Level2"/>

                    <CheckBox Content="Enable UI visual effects (smooth animations)"
                              IsChecked="{Binding EnableVisualEffects}"
                              Foreground="White" Margin="0,5,0,10"
                              AutomationProperties.Name="Enable Visual Effects Toggle"
                              AutomationProperties.HelpText="Subtle fades and motion. Automatically disabled when Windows animations are off. Button hover/press animation changes take effect after restart."/>
                </StackPanel>

                <!-- ── AI Category ───────────────────────────────────────────── -->
                <StackPanel x:Name="AIPanel" Visibility="{Binding SelectedCategory, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=AI}">
                    <TextBlock Text="AI Assistant Settings" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <Ellipse x:Name="AIStatusDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#CC3333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AIConfigured}" Value="True">
                                            <Setter Property="Fill" Value="#33CC66"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding AIStatusText}" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Label Content="Groq API Key" Foreground="White" FontSize="14" Margin="0,0,0,2"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox"
                                     Grid.Column="0"
                                     Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                     BorderBrush="#555555" BorderThickness="1"
                                     Padding="8,6" FontSize="13" FontFamily="Consolas"
                                     AutomationProperties.Name="Groq API Key"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"/>
                        <ToggleButton x:Name="ShowKeyToggle"
                                      Grid.Column="1"
                                      Content="Show" Width="60" Height="28" Margin="6,0,0,0"
                                      Background="#3C3C3C" Foreground="White"
                                      BorderBrush="#555555" BorderThickness="1"
                                      Checked="ShowKeyToggle_Checked"
                                      Unchecked="ShowKeyToggle_Unchecked"/>
                    </Grid>
                    <TextBox x:Name="ApiKeyVisible"
                             Background="#2D2D2D" Foreground="#FFCC44" CaretBrush="White"
                             BorderBrush="#555555" BorderThickness="1"
                             Padding="8,6" FontSize="13" FontFamily="Consolas"
                             Margin="0,0,0,4"
                             Visibility="Collapsed"
                             TextChanged="ApiKeyVisible_TextChanged"/>

                    <Button Content="How to get an API key"
                            Command="{Binding OpenGetApiKeyCommand}"
                            HorizontalAlignment="Left"
                            Background="Transparent" Foreground="#4FC3F7"
                            BorderThickness="0" Cursor="Hand"
                            FontSize="12" Margin="0,2,0,12"/>

                    <Separator Margin="0,10" Background="#444" />

                    <TextBlock Text="Model &amp; Language" FontWeight="Bold" Foreground="White" Margin="0,5" AutomationProperties.HeadingLevel="Level2"/>

                    <Label Target="{Binding ElementName=ModelCombo}" Content="AI Model" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                    <ComboBox x:Name="ModelCombo"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding AIModel}"
                              Margin="0,5,0,10"
                              AutomationProperties.Name="AI Model Selection"
                              AutomationProperties.HelpText="Choose the Groq model to use. 'auto' uses the default Llama 3.3 70B."/>

                    <Label Target="{Binding ElementName=LanguageCombo}" Content="Response Language" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                    <ComboBox x:Name="LanguageCombo"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding AILanguage}"
                              Margin="0,5,0,10"
                              AutomationProperties.Name="AI Language Selection"
                              AutomationProperties.HelpText="Choose the language for AI responses."/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#2D2D30" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Settings" Command="{Binding SaveCommand}" Width="120" Margin="0,0,10,0" Padding="5" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Padding="5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>