<Window x:Class="NexusShell.App.Views.AgentProvidersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        xmlns:helpers="clr-namespace:NexusShell.App.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AgentProvidersViewModel, IsDesignTimeCreatable=False}"
        Title="NexusAgent providers and models" Height="720" Width="1000"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="640" MinHeight="520"
        AutomationProperties.Name="NexusAgent providers and models">

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FormButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="ChoiceItemStyle" TargetType="ComboBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Configured providers -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <Label DockPanel.Dock="Top" Content="Configured _providers:" Target="{Binding ElementName=ProvidersList}" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
            <Button DockPanel.Dock="Bottom" Content="_New provider" Click="New_Click" Style="{StaticResource FormButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                    AutomationProperties.Name="New provider"/>
            <ListBox x:Name="ProvidersList"
                     ItemsSource="{Binding Providers}"
                     SelectedItem="{Binding SelectedProvider}"
                     DisplayMemberPath="Text"
                     Background="#252526" Foreground="#E0E0E0" BorderBrush="#444"
                     AutomationProperties.Name="Configured providers"
                     AutomationProperties.HelpText="Online providers first, then local servers. Select one to edit it.">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                        <Setter Property="ToolTip" Value="{Binding AutomationName}"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- Provider form -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- template -->
                    <RowDefinition Height="Auto"/> <!-- name -->
                    <RowDefinition Height="Auto"/> <!-- protocol -->
                    <RowDefinition Height="Auto"/> <!-- address -->
                    <RowDefinition Height="Auto"/> <!-- local -->
                    <RowDefinition Height="Auto"/> <!-- key variable -->
                    <RowDefinition Height="Auto"/> <!-- key value -->
                    <RowDefinition Height="Auto"/> <!-- key status -->
                    <RowDefinition Height="Auto"/> <!-- default model -->
                    <RowDefinition Height="Auto"/> <!-- model list -->
                    <RowDefinition Height="Auto"/> <!-- prefer -->
                    <RowDefinition Height="Auto"/> <!-- buttons -->
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Start from _template:" Target="{Binding ElementName=PresetCombo}" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="PresetCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" MinHeight="28"
                          helpers:ComboBoxKeyboard.BrowseBeforeChoosing="True" ToolTipService.ShowsToolTipOnKeyboardFocus="False"
                          ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                          AutomationProperties.Name="Start from template"
                          AutomationProperties.HelpText="Fills the form for a well-known provider or local server.">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Notes}"/>
                            <Setter Property="ToolTip" Value="{Binding Notes}"/>
                            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="False"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <Label Grid.Row="1" Content="Na_me:" Target="{Binding ElementName=NameBox}" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}"
                         Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Provider name"
                         AutomationProperties.HelpText="Short name, for example my-server. Used in model names such as my-server/model."/>

                <Label Grid.Row="2" Content="Protoc_ol:" Target="{Binding ElementName=KindCombo}" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="KindCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" MinHeight="28"
                          helpers:ComboBoxKeyboard.BrowseBeforeChoosing="True"
                          ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Text"
                          ItemContainerStyle="{StaticResource ChoiceItemStyle}"
                          AutomationProperties.Name="Protocol"/>

                <Label Grid.Row="3" Content="_Address:" Target="{Binding ElementName=EndpointBox}" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="EndpointBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource FormBox}" FontFamily="Consolas"
                         Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Address, endpoint URL"
                         AutomationProperties.HelpText="For example https://api.example.com/v1, or http://localhost:1234/v1 for a local server. Leave empty for OpenAI and Anthropic."/>

                <CheckBox Grid.Row="4" Grid.Column="1" Content="Runs _locally (on this computer or network; no key needed)" Margin="0,0,0,10"
                          IsChecked="{Binding IsLocal}" Foreground="#E0E0E0"
                          AutomationProperties.Name="Runs locally, on this computer or network, no key needed"/>

                <Label Grid.Row="5" Content="_Key variable name:" Target="{Binding ElementName=KeyVariableBox}" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="KeyVariableBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource FormBox}" FontFamily="Consolas"
                         Text="{Binding KeyVariable, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Key variable name"
                         AutomationProperties.HelpText="The NAME of the environment variable that holds the API key, for example GROQ_API_KEY. Never the key itself."/>

                <Label Grid.Row="6" Content="Key _value:" Target="{Binding ElementName=KeyValueBox}" Style="{StaticResource FormLabel}"/>
                <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="KeyValueBox" Grid.Column="0" Background="#2D2D2D" Foreground="White" CaretBrush="White" BorderBrush="#555" Padding="6,4"
                                 AutomationProperties.Name="API key value"
                                 AutomationProperties.HelpText="Paste the key, then press Store key. It is saved to your Windows user environment and never shown again."/>
                    <Button Grid.Column="1" Content="Sto_re key" Click="StoreKey_Click" Style="{StaticResource FormButton}" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}"
                            AutomationProperties.Name="Store key in my environment"/>
                </Grid>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding KeyStatus}" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Label Grid.Row="8" Content="_Default model:" Target="{Binding ElementName=DefaultModelCombo}" Style="{StaticResource FormLabel}"/>
                <Grid Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DefaultModelCombo" Grid.Column="0" IsEditable="True" MinHeight="28"
                              ItemsSource="{Binding FoundModels}"
                              Text="{Binding DefaultModel, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="Default model"
                              AutomationProperties.HelpText="Type a model name, or press Find models and choose one from the list."/>
                    <Button Grid.Column="1" Content="_Find models" Click="FindModels_Click" Style="{StaticResource FormButton}" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}"
                            AutomationProperties.Name="Find models"
                            AutomationProperties.HelpText="Asks the provider or local server which models it has."/>
                </Grid>

                <Label Grid.Row="9" Content="Model l_ist:" Target="{Binding ElementName=ModelsList}" Style="{StaticResource FormLabel}" VerticalAlignment="Top"/>
                <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ModelsList" Grid.Column="0" Height="110"
                             ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModelInList}"
                             Background="#252526" Foreground="#E0E0E0" BorderBrush="#444"
                             KeyDown="ModelsList_KeyDown"
                             AutomationProperties.Name="More models offered in the chat window's Model box"
                             AutomationProperties.HelpText="Press Delete to remove the selected model."/>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="Add model" Click="AddModel_Click" Style="{StaticResource FormButton}"
                                AutomationProperties.Name="Add the default model box text to the model list"/>
                        <Button Content="Remove model" Click="RemoveModel_Click" Style="{StaticResource FormButton}"
                                AutomationProperties.Name="Remove selected model from the list"/>
                    </StackPanel>
                </Grid>

                <CheckBox Grid.Row="10" Grid.Column="1" Content="_Use this provider first in automatic mode" Margin="0,0,0,12"
                          IsChecked="{Binding Prefer}" Foreground="#E0E0E0"
                          AutomationProperties.Name="Use this provider first in automatic mode"/>

                <WrapPanel Grid.Row="11" Grid.Column="1">
                    <Button Content="_Save provider" Click="Save_Click" Style="{StaticResource FormButton}" Background="#007ACC" FontWeight="SemiBold" IsEnabled="{Binding IsIdle}"
                            AutomationProperties.Name="Save provider"/>
                    <Button Content="Delet_e provider" Click="Remove_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding IsExisting}"
                            AutomationProperties.Name="Delete provider"
                            AutomationProperties.HelpText="Built-in providers are turned off instead of deleted."/>
                </WrapPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#4FC3F7"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding StatusMessage}"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Close" IsCancel="True" Click="Close_Click" Style="{StaticResource FormButton}" Margin="0"
                    AutomationProperties.Name="Close providers window"/>
        </StackPanel>
    </Grid>
</Window>
