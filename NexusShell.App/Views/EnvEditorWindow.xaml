<Window x:Class="NexusShell.App.Views.EnvEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        Title="Environment Variable Manager (Process)" Height="500" Width="800"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Environment Variables (Current Session)" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ListView Grid.Row="1" ItemsSource="{Binding Variables}" SelectedItem="{Binding SelectedVariable}"
                  Background="#252526" Foreground="White" BorderThickness="1" BorderBrush="#444">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Value" Width="550" DisplayMemberBinding="{Binding Value}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Add" Command="{Binding AddVariableCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Edit" Command="{Binding EditVariableCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Delete" Command="{Binding DeleteVariableCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
