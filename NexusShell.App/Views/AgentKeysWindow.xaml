<Window x:Class="NexusShell.App.Views.AgentKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AgentKeysViewModel, IsDesignTimeCreatable=False}"
        Title="NexusAgent keys" Height="560" Width="720"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="520" MinHeight="420"
        AutomationProperties.Name="NexusAgent keys">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="13" Foreground="#CCCCCC"
                   Text="API keys, endpoints and MCP tokens used by NexusAgent. Values are saved as environment variables of your Windows account (never in NexusShell files) and are never shown again." />

        <ListBox x:Name="SecretsList" Grid.Row="1"
                 ItemsSource="{Binding Secrets}"
                 SelectedItem="{Binding SelectedSecret}"
                 Background="#252526" Foreground="#E0E0E0" BorderBrush="#444"
                 AutomationProperties.Name="Agent keys list">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Status}" Width="70" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Variable}" Width="260" FontFamily="Consolas" />
                        <TextBlock Text="{Binding Owner}" Foreground="#AAAAAA" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="_Variable name:" Target="{Binding ElementName=VariableBox}" Foreground="#CCCCCC" />
            <TextBox x:Name="VariableBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                     Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" Background="#2D2D2D" Foreground="White" CaretBrush="White" Padding="6,4"
                     AutomationProperties.Name="Variable name"
                     AutomationProperties.HelpText="Select a key in the list, or type a new environment variable name such as GITHUB_PERSONAL_ACCESS_TOKEN." />

            <Label Grid.Row="1" Grid.Column="0" Content="V_alue:" Target="{Binding ElementName=ValueBox}" Foreground="#CCCCCC" />
            <PasswordBox x:Name="ValueBox" Grid.Row="1" Grid.Column="1"
                         Background="#2D2D2D" Foreground="White" CaretBrush="White" Padding="6,4"
                         AutomationProperties.Name="Key value"
                         AutomationProperties.HelpText="Paste the key. It is saved to your user environment and is not displayed again." />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="_Save to my environment" Click="SaveButton_Click" MinWidth="190" Height="34" Margin="0,0,10,0"
                    Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    IsEnabled="{Binding IsIdle}"
                    AutomationProperties.Name="Save key to my environment" />
            <Button Content="_Remove" Click="RemoveButton_Click" MinWidth="100" Height="34" Margin="0,0,10,0"
                    Background="#3C3C3C" Foreground="White" BorderThickness="0"
                    AutomationProperties.Name="Remove selected key" />
            <Button Content="_Close" IsCancel="True" Click="CloseButton_Click" MinWidth="100" Height="34"
                    Background="#3C3C3C" Foreground="White" BorderThickness="0"
                    AutomationProperties.Name="Close keys window" />
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#4FC3F7"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding StatusMessage}" />

        <TextBlock Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#888888" FontSize="12"
                   Text="Programs that are already running (including terminals) only see new variables after they restart. NexusShell's agent picks them up immediately." />
    </Grid>
</Window>
