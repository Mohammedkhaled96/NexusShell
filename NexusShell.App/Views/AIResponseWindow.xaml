<Window x:Class="NexusShell.App.Views.AIResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="600" Width="800"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="CanResize"
        AutomationProperties.Name="{Binding Title}"
        FocusManager.FocusedElement="{Binding ElementName=ResponseTextBox}">

    <Window.Resources>
        <!-- Re-using existing styles or defining new ones if needed -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Title/Status -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" 
                   AutomationProperties.Name="AI Response Title" />

        <GroupBox Grid.Row="1" Header="NexusAI Insights" Foreground="#888" BorderBrush="#333">
            <TextBox x:Name="ResponseTextBox"
                     Text="{Binding Response, Mode=OneWay}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Foreground="White"
                     Background="#1E1E1E"
                     BorderThickness="0"
                     Padding="15"
                     FontSize="15"
                     FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     IsTabStop="True"
                     AutomationProperties.Name="AI Response Content"
                     AutomationProperties.HelpText="Read-only AI generated content. Use arrow keys to navigate line-by-line." />
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Foreground="#90EE90" 
                       AutomationProperties.LiveSetting="Polite" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy Text" Click="CopyButton_Click" Style="{StaticResource ActionBtn}" Margin="0,0,10,0"
                        AutomationProperties.Name="Copy AI response to clipboard" />
                <Button Content="Go to Chat" Command="{Binding OpenChatCommand}" Style="{StaticResource ActionBtn}" Margin="0,0,10,0"
                        Background="#007ACC"
                        AutomationProperties.Name="Open full chat with this context" />
                <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource ActionBtn}"
                        IsCancel="True"
                        AutomationProperties.Name="Close AI response window" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
