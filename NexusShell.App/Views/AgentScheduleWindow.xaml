<Window x:Class="NexusShell.App.Views.AgentScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        xmlns:helpers="clr-namespace:NexusShell.App.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AgentScheduleViewModel, IsDesignTimeCreatable=False}"
        Title="NexusAgent scheduled tasks" Height="800" Width="960"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="600" MinHeight="560"
        AutomationProperties.Name="NexusAgent scheduled tasks">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="0,0,8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FormButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="ChoiceItemStyle" TargetType="ComboBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- explanation -->
            <RowDefinition Height="200"/>   <!-- list -->
            <RowDefinition Height="*"/>     <!-- form -->
            <RowDefinition Height="Auto"/>  <!-- buttons + status -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#CCCCCC" FontSize="13"
                   Text="NexusAgent does these tasks by itself at the times you choose, and saves each result as a chat you can open and continue. You can also ask in the chat, for example: every weekday at 9 check free disk space."/>

        <DockPanel Grid.Row="1">
            <Grid DockPanel.Dock="Top">
                <Label Content="Scheduled tas_ks:" Target="{Binding ElementName=TaskList}" Style="{StaticResource FormLabel}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Summary}" Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Summary}"/>
            </Grid>
            <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" DisplayMemberPath="Text"
                     Background="#252526" Foreground="#E0E0E0" BorderBrush="#444"
                     KeyDown="TaskList_KeyDown"
                     AutomationProperties.Name="{Binding Summary}"
                     AutomationProperties.HelpText="Arrow keys read each task with its next run and last result. Its details appear below for editing. Delete removes it.">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                        <Setter Property="ToolTip" Value="{Binding AutomationName}"/>
                        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="False"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- name -->
                    <RowDefinition Height="Auto"/> <!-- prompt -->
                    <RowDefinition Height="Auto"/> <!-- date + time -->
                    <RowDefinition Height="Auto"/> <!-- repeat -->
                    <RowDefinition Height="Auto"/> <!-- interval -->
                    <RowDefinition Height="Auto"/> <!-- days -->
                    <RowDefinition Height="Auto"/> <!-- permission -->
                    <RowDefinition Height="Auto"/> <!-- folder -->
                    <RowDefinition Height="Auto"/> <!-- options -->
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="_Name:" Target="{Binding ElementName=NameBox}" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FormBox}" MaxLength="100"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Task name"/>

                <Label Grid.Row="1" Content="_What should the agent do?" Target="{Binding ElementName=PromptBox}" Style="{StaticResource FormLabel}" VerticalAlignment="Top"/>
                <TextBox x:Name="PromptBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBox}" MaxLength="4000"
                         Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"
                         AutomationProperties.Name="What should the agent do"
                         AutomationProperties.HelpText="A complete instruction, for example: Check free space on every drive and list folders in Downloads larger than 1 GB."/>

                <Label Grid.Row="2" Content="_Date:" Target="{Binding ElementName=DateBox}" Style="{StaticResource FormLabel}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <DatePicker x:Name="DateBox" SelectedDate="{Binding Date}" Width="180" SelectedDateFormat="Long"
                                AutomationProperties.Name="Date of the first run"/>
                    <Label Content="T_ime:" Target="{Binding ElementName=TimeBox}" Style="{StaticResource FormLabel}" Margin="16,0,0,0"/>
                    <TextBox x:Name="TimeBox" Width="80" Style="{StaticResource FormBox}" Margin="0" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Time of day, 24-hour, for example 09:00"/>
                </StackPanel>

                <Label Grid.Row="3" Content="_Repeat:" Target="{Binding ElementName=RepeatCombo}" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="RepeatCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" MinHeight="28" HorizontalAlignment="Left" Width="320"
                          ItemsSource="{Binding Repeats}" SelectedItem="{Binding SelectedRepeat}" DisplayMemberPath="Text"
                          ItemContainerStyle="{StaticResource ChoiceItemStyle}"
                          helpers:ComboBoxKeyboard.BrowseBeforeChoosing="True"
                          AutomationProperties.Name="Repeat"/>

                <Label Grid.Row="4" Content="Every how many _minutes:" Target="{Binding ElementName=IntervalBox}" Style="{StaticResource FormLabel}"
                       Visibility="{Binding IsInterval, Converter={StaticResource BoolToVis}}"/>
                <TextBox x:Name="IntervalBox" Grid.Row="4" Grid.Column="1" Width="100" HorizontalAlignment="Left" Style="{StaticResource FormBox}"
                         Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInterval, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.Name="Minutes between runs, at least 5; 60 is every hour"/>

                <TextBlock Grid.Row="5" Text="On these days:" Foreground="#CCCCCC" VerticalAlignment="Top" Margin="0,4,0,0"
                           Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Days}" Margin="0,0,0,8" IsTabStop="False"
                              Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.Name="Days of the week">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Foreground="#E0E0E0" Margin="0,4,14,4"
                                      AutomationProperties.Name="{Binding Name}">
                                <TextBlock Text="{Binding Name}"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Label Grid.Row="6" Content="_Permissions:" Target="{Binding ElementName=PermissionCombo}" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="PermissionCombo" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" MinHeight="28" HorizontalAlignment="Left" Width="420"
                          ItemsSource="{Binding Permissions}" SelectedItem="{Binding SelectedPermission}" DisplayMemberPath="Text"
                          ItemContainerStyle="{StaticResource ChoiceItemStyle}"
                          helpers:ComboBoxKeyboard.BrowseBeforeChoosing="True"
                          AutomationProperties.Name="Permissions during the run"
                          AutomationProperties.HelpText="Nobody may be watching: commands and other actions that need approval are always skipped and reported."/>

                <Label Grid.Row="7" Content="Working _folder:" Target="{Binding ElementName=FolderBox}" Style="{StaticResource FormLabel}"/>
                <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource FormBox}" Margin="0" Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Working folder, optional"/>
                    <Button Grid.Column="1" Content="_Browse..." Click="Browse_Click" Style="{StaticResource FormButton}" Margin="8,0,0,0" MinWidth="100"
                            AutomationProperties.Name="Choose the working folder"/>
                </Grid>

                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,4,0,8">
                    <CheckBox IsChecked="{Binding SameChat}" Foreground="#E0E0E0" Margin="0,0,0,6"
                              AutomationProperties.Name="Continue the same chat on every run, so the agent remembers earlier runs">
                        <AccessText Text="Continue the _same chat on every run (the agent remembers earlier runs)" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RunIfMissed}" Foreground="#E0E0E0"
                              AutomationProperties.Name="If NexusShell was closed at that time, run when it starts">
                        <AccessText Text="If NexusShell was _closed at that time, run when it starts" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <WrapPanel>
                <Button Content="_Add task" Click="Add_Click" Style="{StaticResource FormButton}" Background="#007ACC" FontWeight="SemiBold"
                        AutomationProperties.Name="Add as a new scheduled task"/>
                <Button Content="Sa_ve changes" Click="Save_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Save changes to the selected task"/>
                <Button Content="Run n_ow" Click="RunNow_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Run the selected task now"/>
                <Button Content="Open _last result" Click="OpenResult_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasResult}"
                        AutomationProperties.Name="Open the last result of the selected task in the chat window"/>
                <Button Content="T_urn on or off" Click="Toggle_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Turn the selected task on or off"/>
                <Button Content="Del_ete" Click="Delete_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Delete the selected task"/>
                <Button Content="Empty form" Click="NewForm_Click" Style="{StaticResource FormButton}"
                        AutomationProperties.Name="Empty the form to add a new task"/>
                <Button Content="Close" IsCancel="True" Click="Close_Click" Style="{StaticResource FormButton}"
                        AutomationProperties.Name="Close scheduled tasks"/>
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#4FC3F7" Margin="0,4,0,0"
                       Text="{Binding StatusMessage}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding StatusMessage}"/>
        </StackPanel>
    </Grid>
</Window>
