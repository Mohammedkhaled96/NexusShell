<Window x:Class="NexusShell.App.Views.AgentMemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        xmlns:helpers="clr-namespace:NexusShell.App.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AgentMemoryViewModel, IsDesignTimeCreatable=False}"
        Title="NexusAgent memory" Height="720" Width="900"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="560" MinHeight="520"
        AutomationProperties.Name="NexusAgent memory">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FormButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- explanation -->
            <RowDefinition Height="Auto"/> <!-- search -->
            <RowDefinition Height="*"/>    <!-- list -->
            <RowDefinition Height="Auto"/> <!-- editor -->
            <RowDefinition Height="Auto"/> <!-- status -->
            <RowDefinition Height="Auto"/> <!-- close -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#CCCCCC" FontSize="13"
                   Text="NexusAgent remembers these facts between conversations and recalls the relevant ones for each message, so it answers from what you told it instead of guessing. You can also say &quot;remember that ...&quot; in the chat, or type /remember. Memories never contain passwords or keys." />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="_Search:" Target="{Binding ElementName=SearchBox}" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Padding="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#2D2D2D" Foreground="White" CaretBrush="White" BorderBrush="#555" Padding="6,4"
                     AutomationProperties.Name="Search memories"
                     AutomationProperties.HelpText="Type words to show only the memories that contain them." />
            <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="12,0,0,0"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Summary}"/>
        </Grid>

        <DockPanel Grid.Row="2">
            <Label DockPanel.Dock="Top" Content="Saved _memories:" Target="{Binding ElementName=MemoryList}" Style="{StaticResource FormLabel}"/>
            <ListBox x:Name="MemoryList"
                     ItemsSource="{Binding Memories}"
                     SelectedItem="{Binding SelectedMemory}"
                     Background="#252526" Foreground="#E0E0E0" BorderBrush="#444"
                     KeyDown="MemoryList_KeyDown"
                     AutomationProperties.Name="{Binding Summary}"
                     AutomationProperties.HelpText="Arrow keys read each memory. Delete removes the selected one; its text appears below for editing.">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                        <Setter Property="ToolTip" Value="{Binding AutomationName}"/>
                        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="False"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Content="Memory _text:" Target="{Binding ElementName=MemoryTextBox}" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="MemoryTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                     Text="{Binding MemoryText, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56" MaxLength="1000"
                     Background="#2D2D2D" Foreground="White" CaretBrush="White" BorderBrush="#555" Padding="6,4"
                     AutomationProperties.Name="Memory text"
                     AutomationProperties.HelpText="One short fact, for example: I use PowerShell 7 and prefer short answers. Never a password or key." />

            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Label Content="_Kind:" Target="{Binding ElementName=KindCombo}" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Padding="0,0,8,0"/>
                <ComboBox x:Name="KindCombo" Width="180" MinHeight="28"
                          ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Text"
                          helpers:ComboBoxKeyboard.BrowseBeforeChoosing="True"
                          AutomationProperties.Name="Kind of memory"/>
                <CheckBox Content="_Pin (recall in every conversation)" IsChecked="{Binding PinNew}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="16,0,0,0"
                          AutomationProperties.Name="Pin the new memory: recall it in every conversation"/>
            </StackPanel>
            <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding FolderOnly}" IsEnabled="{Binding HasWorkingFolder}" Foreground="#E0E0E0" Margin="0,0,0,10"
                      AutomationProperties.Name="{Binding FolderOnlyLabel}">
                <TextBlock Text="{Binding FolderOnlyLabel}" TextWrapping="Wrap"/>
            </CheckBox>
        </Grid>

        <StackPanel Grid.Row="4">
            <WrapPanel>
                <Button Content="_Add as new" Click="Add_Click" Style="{StaticResource FormButton}" Background="#007ACC" FontWeight="SemiBold"
                        AutomationProperties.Name="Add the text as a new memory"/>
                <Button Content="Sa_ve changes" Click="SaveChanges_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Save the text into the selected memory"/>
                <Button Content="Pin or u_npin" Click="TogglePin_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Pin or unpin the selected memory"/>
                <Button Content="_Delete" Click="Delete_Click" Style="{StaticResource FormButton}" IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Delete the selected memory"/>
                <Button Content="Delete a_ll..." Click="Clear_Click" Style="{StaticResource FormButton}"
                        AutomationProperties.Name="Delete all memories"/>
            </WrapPanel>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#4FC3F7"
                       Text="{Binding StatusMessage}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding StatusMessage}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Close" IsCancel="True" Click="Close_Click" Style="{StaticResource FormButton}" Margin="0"
                    AutomationProperties.Name="Close memory window"/>
        </StackPanel>
    </Grid>
</Window>
