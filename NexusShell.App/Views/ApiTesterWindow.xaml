<Window x:Class="NexusShell.App.Views.ApiTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        xmlns:models="clr-namespace:NexusShell.App.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:ApiTesterViewModel}"
        Title="NexusShell — API Tester"
        MinWidth="960" MinHeight="600"
        Width="1280" Height="820"
        WindowState="Maximized"
        Background="#1E1E1E" Foreground="#CCCCCC"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="NexusShell API Tester">

    <!-- Keyboard shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SendRequestCommand}" />
        <KeyBinding Key="Escape"                     Command="{Binding CancelRequestCommand}" />
        <KeyBinding Key="S"      Modifiers="Control" Command="{Binding SaveActiveRequestCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Toolbar -->
            <RowDefinition Height="*"    />   <!-- Main -->
            <RowDefinition Height="Auto" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             TOOLBAR
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#252526" Padding="10,7"
                BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165" />  <!-- Env -->
                    <ColumnDefinition Width="108" />  <!-- Method -->
                    <ColumnDefinition Width="*"   />  <!-- URL -->
                    <ColumnDefinition Width="80"  />  <!-- SEND -->
                    <ColumnDefinition Width="Auto"/>  <!-- SAVE -->
                    <ColumnDefinition Width="Auto"/>  <!-- CANCEL -->
                </Grid.ColumnDefinitions>

                <!-- Environment selector -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Environments}"
                          SelectedItem="{Binding ActiveEnvironment}"
                          DisplayMemberPath="Name"
                          Height="34" Margin="0,0,8,0"
                          Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Active environment" />

                <!-- HTTP Method -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Source={x:Static models:HttpMethodType.GET}, Converter={StaticResource EnumToCollectionConverter}}"
                          SelectedItem="{Binding ActiveRequest.Method}"
                          Height="34" Margin="0,0,8,0"
                          Background="#2D2D2D"
                          Foreground="{Binding ActiveRequest.Method, Converter={StaticResource MethodColorConverter}}"
                          BorderBrush="#555" FontWeight="Bold" FontSize="13"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="HTTP method" />

                <!-- URL -->
                <TextBox Grid.Column="2"
                         x:Name="UrlInput"
                         Text="{Binding ActiveRequest.Url, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Margin="0,0,8,0"
                         Background="#2D2D2D" Foreground="White" CaretBrush="White"
                         BorderBrush="#555" BorderThickness="1"
                         Padding="10,0" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="13"
                         AutomationProperties.Name="Request URL"
                         AutomationProperties.HelpText="Enter URL. Use {{variableName}} for variables. Ctrl+Enter sends." />

                <!-- SEND -->
                <Button Grid.Column="3"
                        Content="SEND"
                        Command="{Binding SendRequestCommand}"
                        Height="34" Margin="0,0,6,0"
                        Background="#007ACC" Foreground="White"
                        FontWeight="Bold" FontSize="13" BorderThickness="0"
                        ToolTip="Send request (Ctrl+Enter)"
                        AutomationProperties.Name="Send request (Ctrl+Enter)" />

                <!-- SAVE — saves active request back to its collection -->
                <Button Grid.Column="4"
                        Content="💾 Save"
                        Command="{Binding SaveActiveRequestCommand}"
                        Height="34" Width="72" Margin="6,0,0,0"
                        Background="#2D5A27" Foreground="White"
                        FontWeight="Bold" BorderThickness="0"
                        ToolTip="Save current request back to collection (Ctrl+S)"
                        AutomationProperties.Name="Save request to collection (Ctrl+S)" />

                <!-- CANCEL — visible only while sending -->
                <Button Grid.Column="5"
                        Content="CANCEL"
                        Command="{Binding CancelRequestCommand}"
                        Height="34" Width="72" Margin="6,0,0,0"
                        Background="#4A4A4A" Foreground="White"
                        FontWeight="Bold" BorderThickness="0"
                        Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Cancel in-flight request (Escape)"
                        AutomationProperties.Name="Cancel request (Escape)" />
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             MAIN AREA: Sidebar | Request builder
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="150" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── SIDEBAR ──────────────────────────────────────────── -->
            <Grid Grid.Column="0" Background="#252526">
                <TabControl Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Sidebar">

                    <!-- Collections tab -->
                    <TabItem Header="Collections"
                             AutomationProperties.Name="Collections tab">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"    />
                            </Grid.RowDefinitions>

                            <!-- Action bar -->
                            <Border Grid.Row="0" Background="#2D2D2D" Padding="6,5">
                                <WrapPanel>
                                    <Button Content="＋ New"
                                            Command="{Binding NewCollectionCommand}"
                                            Height="24" Padding="6,2" Margin="0,0,4,0"
                                            Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                            ToolTip="New collection"
                                            AutomationProperties.Name="New collection" />
                                    <Button Content="⬆ Import"
                                            Command="{Binding ImportCollectionCommand}"
                                            Height="24" Padding="6,2"
                                            Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                            ToolTip="Import Postman v2.1 JSON or OpenAPI 3.x JSON/YAML"
                                            AutomationProperties.Name="Import collection" />
                                </WrapPanel>
                            </Border>

                            <!-- Collections tree -->
                            <TreeView Grid.Row="1"
                                      x:Name="CollectionsTree"
                                      ItemsSource="{Binding Collections}"
                                      Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseRightButtonDown="CollectionsTree_RightClick"
                                      SelectedItemChanged="CollectionsTree_SelectedItemChanged"
                                      KeyDown="CollectionsTree_KeyDown"
                                      AutomationProperties.Name="Collections tree"
                                      AutomationProperties.HelpText="Arrow keys to navigate. Left-click loads a request. Right-click or Menu key for actions.">

                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded"               Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="Foreground"               Value="#CCCCCC" />
                                        <Setter Property="Background"               Value="Transparent" />
                                        <Setter Property="Padding"                  Value="3,2" />
                                        <!-- Stretch content so the action-button panel anchors to the right edge -->
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#094771" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A2D2E" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.ItemContainerStyle>

                                <TreeView.Resources>

                                    <!-- ── Compact action button used in all DataTemplates ─────────────
                                         Uses a custom ControlTemplate to stay borderless and dark-themed.
                                         RelativeSource=TreeView walks the VISUAL tree (not name scope) so
                                         it works correctly even for items inside a CompositeCollection. -->
                                    <Style x:Key="TreeActionBtn" TargetType="Button">
                                        <Setter Property="Background"        Value="Transparent" />
                                        <Setter Property="Foreground"        Value="#707070" />
                                        <Setter Property="BorderThickness"   Value="0" />
                                        <Setter Property="Padding"           Value="3,1" />
                                        <Setter Property="Margin"            Value="1,0,0,0" />
                                        <Setter Property="Height"            Value="17" />
                                        <Setter Property="MinWidth"          Value="20" />
                                        <Setter Property="FontSize"          Value="11" />
                                        <Setter Property="Cursor"            Value="Hand" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FocusVisualStyle"  Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="2"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#404040" />
                                                            <Setter Property="Foreground" Value="#E0E0E0" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#505050" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- ── ApiCollection node ────────────────────────────────────────── -->
                                    <HierarchicalDataTemplate DataType="{x:Type models:ApiCollection}"
                                                              ItemsSource="{Binding Items}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"    />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Row label -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Always-visible "⋯" application button → opens the same context menu
                                                 right-click would show. Backed by ItemMenuButton_Click in code-behind. -->
                                            <Button Grid.Column="1"
                                                    Content="⋯"
                                                    Style="{StaticResource TreeActionBtn}"
                                                    FontSize="14" FontWeight="Bold"
                                                    MinWidth="22" Margin="2,0,2,0"
                                                    Foreground="#9CDCFE"
                                                    Click="ItemMenuButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Actions — Add / Rename / Export / Delete"
                                                    AutomationProperties.Name="Collection actions menu" />
                                        </Grid>
                                    </HierarchicalDataTemplate>

                                    <!-- ── ApiFolder node ─────────────────────────────────────────────── -->
                                    <HierarchicalDataTemplate DataType="{x:Type models:ApiFolder}"
                                                              ItemsSource="{Binding Items}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"    />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📂 " FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                           Foreground="#CCCCCC" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="⋯"
                                                    Style="{StaticResource TreeActionBtn}"
                                                    FontSize="14" FontWeight="Bold"
                                                    MinWidth="22" Margin="2,0,2,0"
                                                    Foreground="#9CDCFE"
                                                    Click="ItemMenuButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Actions — Add / Rename / Delete"
                                                    AutomationProperties.Name="Folder actions menu" />
                                        </Grid>
                                    </HierarchicalDataTemplate>

                                    <!-- ── ApiRequest leaf ────────────────────────────────────────────────
                                         Left-click   → CollectionsTree_SelectedItemChanged (code-behind)
                                         Right-click  → CollectionsTree_RightClick          (code-behind)
                                         Menu key     → CollectionsTree_KeyDown             (code-behind)
                                         Buttons use RelativeSource=TreeView which walks the visual tree —
                                         reliable even for items rendered inside a CompositeCollection. -->
                                    <DataTemplate DataType="{x:Type models:ApiRequest}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"    />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Background="Transparent" Cursor="Hand">
                                                <TextBlock Text="{Binding Method}"
                                                           Foreground="{Binding Method, Converter={StaticResource MethodColorConverter}}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Width="42" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#CCCCCC" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="⋯"
                                                    Style="{StaticResource TreeActionBtn}"
                                                    FontSize="14" FontWeight="Bold"
                                                    MinWidth="22" Margin="2,0,2,0"
                                                    Foreground="#9CDCFE"
                                                    Click="ItemMenuButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Actions — Load / Rename / Duplicate / Delete"
                                                    AutomationProperties.Name="Request actions menu" />
                                        </Grid>
                                    </DataTemplate>

                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </TabItem>

                    <!-- History tab -->
                    <TabItem Header="History"
                             AutomationProperties.Name="Request history tab">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"    />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Content="Clear History"
                                    Command="{Binding ClearHistoryCommand}"
                                    Margin="6,5" Height="24"
                                    Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                    AutomationProperties.Name="Clear request history" />

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding History}"
                                      Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Request history"
                                      AutomationProperties.LiveSetting="Polite">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background"               Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A2D2E" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.LoadFromHistoryCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Padding="4,3" Cursor="Hand">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Method}"
                                                               Foreground="{Binding Method, Converter={StaticResource MethodColorConverter}}"
                                                               FontSize="10" FontWeight="Bold" Width="40" />
                                                    <TextBlock Text="{Binding StatusCode}"
                                                               Foreground="{Binding StatusCode, Converter={StaticResource StatusColorConverter}}"
                                                               FontSize="11" FontWeight="Bold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}"
                                                           FontSize="10" Foreground="#999"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="205" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss  dd/MM}'}"
                                                           FontSize="10" Foreground="#555" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Sidebar splitter -->
            <GridSplitter Grid.Column="1"
                          Background="#3C3C3C" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Sidebar width adjuster" />

            <!-- ─── RIGHT PANE: Request builder + inline response ─────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="220" />  <!-- Request builder -->
                    <RowDefinition Height="5"                  />  <!-- Splitter        -->
                    <RowDefinition Height="*"  MinHeight="140" />  <!-- Response panel  -->
                </Grid.RowDefinitions>

                <!-- ── Request builder ────────────────────────────────── -->
                <TabControl Grid.Row="0"
                            Background="Transparent" BorderBrush="#3C3C3C"
                            AutomationProperties.Name="Request configuration tabs">

                <!-- Params -->
                <TabItem Header="Params" AutomationProperties.Name="Query parameters tab">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Query Parameters"
                                   Foreground="#888" FontSize="11" Margin="0,0,0,6" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ActiveRequest.Parameters}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="#1E1E1E" Foreground="White"
                                  BorderBrush="#3C3C3C" GridLinesVisibility="Horizontal"
                                  RowBackground="#1E1E1E" AlternatingRowBackground="#242424"
                                  ColumnHeaderHeight="26" RowHeight="28"
                                  AutomationProperties.Name="Query parameters table">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On"    Binding="{Binding IsEnabled}" Width="38" />
                                <DataGridTextColumn    Header="Key"   Binding="{Binding Key,   UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn    Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Content="＋ Add Parameter"
                                Command="{Binding AddParamCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Height="26" Padding="8,3"
                                Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                AutomationProperties.Name="Add parameter row" />
                    </Grid>
                </TabItem>

                <!-- Headers -->
                <TabItem Header="Headers" AutomationProperties.Name="Request headers tab">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Request Headers"
                                   Foreground="#888" FontSize="11" Margin="0,0,0,6" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ActiveRequest.Headers}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="#1E1E1E" Foreground="White"
                                  BorderBrush="#3C3C3C" GridLinesVisibility="Horizontal"
                                  RowBackground="#1E1E1E" AlternatingRowBackground="#242424"
                                  ColumnHeaderHeight="26" RowHeight="28"
                                  AutomationProperties.Name="Request headers table">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On"     Binding="{Binding IsEnabled}" Width="38" />
                                <DataGridTextColumn    Header="Header" Binding="{Binding Key,   UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn    Header="Value"  Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Content="＋ Add Header"
                                Command="{Binding AddHeaderCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Height="26" Padding="8,3"
                                Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                AutomationProperties.Name="Add header row" />
                    </Grid>
                </TabItem>

                <!-- Auth -->
                <TabItem Header="Auth" AutomationProperties.Name="Authorization tab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15,10" MaxWidth="500">
                            <Label Content="Authorization Type" Foreground="#888" Padding="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AuthTypes}"
                                      SelectedItem="{Binding AuthType}"
                                      Height="32" Margin="0,0,0,16"
                                      Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.Name="Authorization type" />

                            <!-- Bearer — secret field, masked by default; Show toggle reveals -->
                            <StackPanel Visibility="{Binding IsBearerAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel>
                                    <Label x:Name="BearerLabel" DockPanel.Dock="Left"
                                           Content="Bearer Token:" Foreground="White" Padding="0,0,0,4" />
                                    <CheckBox x:Name="BearerShow" DockPanel.Dock="Right"
                                              Content="Show" Foreground="#888"
                                              VerticalAlignment="Center" Margin="6,0,0,0" />
                                </DockPanel>
                                <Grid>
                                    <PasswordBox x:Name="BearerPasswordBox"
                                                 PasswordChanged="BearerPasswordBox_Changed"
                                                 Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                                 BorderBrush="#555" Padding="8,6" FontFamily="Consolas"
                                                 Visibility="{Binding ElementName=BearerShow, Path=IsChecked,
                                                              Converter={StaticResource BoolToVisibilityConverter},
                                                              ConverterParameter=invert}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=BearerLabel}" />
                                    <TextBox Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                             BorderBrush="#555" Padding="8,6" FontFamily="Consolas"
                                             Visibility="{Binding ElementName=BearerShow, Path=IsChecked,
                                                          Converter={StaticResource BoolToVisibilityConverter}}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=BearerLabel}" />
                                </Grid>
                            </StackPanel>

                            <!-- Basic — username plain, password masked with Show toggle -->
                            <StackPanel Visibility="{Binding IsBasicAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Label x:Name="UserLabel" Content="Username:" Foreground="White" Padding="0,0,0,4" />
                                <TextBox Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                         BorderBrush="#555" Padding="8,6" Margin="0,0,0,10"
                                         AutomationProperties.LabeledBy="{Binding ElementName=UserLabel}" />
                                <DockPanel>
                                    <Label x:Name="PassLabel" DockPanel.Dock="Left"
                                           Content="Password:" Foreground="White" Padding="0,0,0,4" />
                                    <CheckBox x:Name="BasicShow" DockPanel.Dock="Right"
                                              Content="Show" Foreground="#888"
                                              VerticalAlignment="Center" Margin="6,0,0,0" />
                                </DockPanel>
                                <Grid>
                                    <PasswordBox x:Name="BasicPasswordBox"
                                                 PasswordChanged="BasicPasswordBox_Changed"
                                                 Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                                 BorderBrush="#555" Padding="8,6"
                                                 Visibility="{Binding ElementName=BasicShow, Path=IsChecked,
                                                              Converter={StaticResource BoolToVisibilityConverter},
                                                              ConverterParameter=invert}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=PassLabel}" />
                                    <TextBox Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                             BorderBrush="#555" Padding="8,6"
                                             Visibility="{Binding ElementName=BasicShow, Path=IsChecked,
                                                          Converter={StaticResource BoolToVisibilityConverter}}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=PassLabel}" />
                                </Grid>
                            </StackPanel>

                            <!-- ApiKey — name plain, value masked with Show toggle -->
                            <StackPanel Visibility="{Binding IsApiKeyAuth, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Label x:Name="KeyNameLabel" Content="Key Name:" Foreground="White" Padding="0,0,0,4" />
                                <TextBox Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                         BorderBrush="#555" Padding="8,6" Margin="0,0,0,10"
                                         AutomationProperties.LabeledBy="{Binding ElementName=KeyNameLabel}" />
                                <DockPanel>
                                    <Label x:Name="KeyValLabel" DockPanel.Dock="Left"
                                           Content="Key Value:" Foreground="White" Padding="0,0,0,4" />
                                    <CheckBox x:Name="ApiKeyShow" DockPanel.Dock="Right"
                                              Content="Show" Foreground="#888"
                                              VerticalAlignment="Center" Margin="6,0,0,0" />
                                </DockPanel>
                                <Grid Margin="0,0,0,10">
                                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                                 PasswordChanged="ApiKeyPasswordBox_Changed"
                                                 Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                                 BorderBrush="#555" Padding="8,6"
                                                 Visibility="{Binding ElementName=ApiKeyShow, Path=IsChecked,
                                                              Converter={StaticResource BoolToVisibilityConverter},
                                                              ConverterParameter=invert}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=KeyValLabel}" />
                                    <TextBox Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#2D2D2D" Foreground="White" CaretBrush="White"
                                             BorderBrush="#555" Padding="8,6"
                                             Visibility="{Binding ElementName=ApiKeyShow, Path=IsChecked,
                                                          Converter={StaticResource BoolToVisibilityConverter}}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=KeyValLabel}" />
                                </Grid>
                                <Label x:Name="KeyLocLabel" Content="Add to:" Foreground="White" Padding="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ApiKeyLocations}"
                                          SelectedItem="{Binding ApiKeyLocation}"
                                          Height="32"
                                          Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.LabeledBy="{Binding ElementName=KeyLocLabel}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Body -->
                <TabItem Header="Body" AutomationProperties.Name="Request body tab">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                        </Grid.RowDefinitions>

                        <!-- Body type radios -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="none"                IsChecked="{Binding IsBodyNone}"       Foreground="White" Margin="0,0,12,0" />
                            <RadioButton Content="JSON"                IsChecked="{Binding IsBodyJson}"       Foreground="#9CDCFE" FontWeight="SemiBold" Margin="0,0,12,0"
                                                                       ToolTip="JSON body (sets Content-Type: application/json)" />
                            <RadioButton Content="raw"                 IsChecked="{Binding IsBodyRaw}"        Foreground="White" Margin="0,0,12,0"
                                                                       ToolTip="Raw text/XML/HTML body" />
                            <RadioButton Content="form-data"           IsChecked="{Binding IsBodyFormData}"   Foreground="White" Margin="0,0,12,0" />
                            <RadioButton Content="x-www-form-urlencoded" IsChecked="{Binding IsBodyUrlEncoded}" Foreground="White" />
                        </StackPanel>

                        <!-- Raw format + Format JSON button + live validation indicator -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,6"
                                   Visibility="{Binding IsBodyRawAny, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Label DockPanel.Dock="Left" x:Name="FmtLabel"
                                   Content="Format:" Foreground="#888"
                                   Padding="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox DockPanel.Dock="Left"
                                      ItemsSource="{Binding Source={x:Static models:ApiRawType.JSON}, Converter={StaticResource EnumToCollectionConverter}}"
                                      SelectedItem="{Binding ActiveRequest.RawType}"
                                      Height="28" Width="80" Margin="0,0,8,0"
                                      Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.LabeledBy="{Binding ElementName=FmtLabel}" />
                            <Button DockPanel.Dock="Left"
                                    Content="{}{ } Format JSON"
                                    Command="{Binding BeautifyBodyCommand}"
                                    Height="28" Padding="10,3" Margin="0,0,10,0"
                                    Background="#2D2D2D" Foreground="#9CDCFE"
                                    BorderBrush="#555" BorderThickness="1" FontSize="11"
                                    ToolTip="Beautify / pretty-print JSON body (only when Format = JSON)"
                                    AutomationProperties.Name="Format JSON body" />
                            <!-- Live JSON validation status — updated on every keystroke via code-behind -->
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding JsonValidationStatus}"
                                       Foreground="{Binding JsonValidationBrush}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="JSON validation status"
                                       AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>

                        <!-- Raw editor — TextChanged fires live JSON validation in code-behind -->
                        <TextBox Grid.Row="2"
                                 Text="{Binding ActiveRequest.BodyContent, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="JsonBody_TextChanged"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 Background="#1A1A1A" Foreground="#D4D4D4" CaretBrush="White"
                                 BorderBrush="#3C3C3C" BorderThickness="1" Padding="10"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsBodyRawAny, Converter={StaticResource BoolToVisibilityConverter}}"
                                 AutomationProperties.Name="Request body editor"
                                 AutomationProperties.HelpText="Write JSON, XML, or plain text. Use Format JSON button to beautify." />

                        <!-- Form table -->
                        <Grid Grid.Row="2"
                              Visibility="{Binding IsBodyForm, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"    />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding ActiveRequest.Parameters}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      Background="#1E1E1E" Foreground="White"
                                      BorderBrush="#3C3C3C" GridLinesVisibility="Horizontal"
                                      RowBackground="#1E1E1E" AlternatingRowBackground="#242424"
                                      ColumnHeaderHeight="26" RowHeight="28"
                                      AutomationProperties.Name="Form fields table">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="On"    Binding="{Binding IsEnabled}" Width="38" />
                                    <DataGridTextColumn    Header="Key"   Binding="{Binding Key,   UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <DataGridTextColumn    Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Grid.Row="1" Content="＋ Add Field"
                                    Command="{Binding AddParamCommand}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Height="26" Padding="8,3"
                                    Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                    AutomationProperties.Name="Add form field" />
                        </Grid>

                        <!-- No-body placeholder -->
                        <Border Grid.Row="2"
                                Visibility="{Binding IsBodyNone, Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No body selected. Choose JSON, raw, form-data, or x-www-form-urlencoded."
                                       Foreground="#555" FontSize="13" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Pre-request Script -->
                <TabItem Header="Pre-request" AutomationProperties.Name="Pre-request script tab">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Pre-request script — executed before the request is sent."
                                   Foreground="#888" FontSize="11" Margin="0,0,0,6" />
                        <TextBox Grid.Row="1"
                                 Text="{Binding ActiveRequest.PreRequestScript, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 Background="#1A1A1A" Foreground="#9CDCFE" CaretBrush="White"
                                 BorderBrush="#3C3C3C" BorderThickness="1" Padding="10"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Pre-request script editor" />
                    </Grid>
                </TabItem>

                <!-- Tests -->
                <TabItem Header="Tests" AutomationProperties.Name="Test assertions tab">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Test assertions — written against the response."
                                   Foreground="#888" FontSize="11" Margin="0,0,0,6" />
                        <TextBox Grid.Row="1"
                                 Text="{Binding ActiveRequest.TestScript, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 Background="#1A1A1A" Foreground="#CE9178" CaretBrush="White"
                                 BorderBrush="#3C3C3C" BorderThickness="1" Padding="10"
                                 FontFamily="Consolas" FontSize="13"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Test script editor" />
                    </Grid>
                </TabItem>

                <!-- Code generator -->
                <TabItem Header="Code" AutomationProperties.Name="Code snippet tab">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*"    />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Label DockPanel.Dock="Left" x:Name="LangLabel"
                                   Content="Language:" Foreground="#888"
                                   Padding="0,0,8,0" VerticalAlignment="Center" />
                            <ComboBox DockPanel.Dock="Left"
                                      ItemsSource="{Binding CodeLanguages}"
                                      SelectedItem="{Binding SelectedCodeLanguage}"
                                      Height="28" Width="120"
                                      Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                                      VerticalContentAlignment="Center" Margin="0,0,8,0"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LangLabel}" />
                            <Button DockPanel.Dock="Left"
                                    Content="⟳ Refresh"
                                    Command="{Binding RefreshCodeSnippetCommand}"
                                    Height="28" Padding="8,3" Margin="0,0,6,0"
                                    Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                    ToolTip="Regenerate snippet from current request"
                                    AutomationProperties.Name="Refresh code snippet" />
                            <Button DockPanel.Dock="Left"
                                    Content="⧉ Copy"
                                    Command="{Binding CopyCodeSnippetCommand}"
                                    Height="28" Padding="8,3"
                                    Background="#333" Foreground="White" BorderThickness="0" FontSize="11"
                                    AutomationProperties.Name="Copy code snippet" />
                        </DockPanel>
                        <TextBox Grid.Row="1"
                                 Text="{Binding CodeSnippet, Mode=OneWay}"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 Background="#1A1A1A" Foreground="#9CDCFE" CaretBrush="White"
                                 BorderBrush="#3C3C3C" BorderThickness="1" Padding="10"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Generated code snippet" />
                    </Grid>
                </TabItem>

                </TabControl>

                <!-- ── Row splitter ───────────────────────────────────── -->
                <GridSplitter Grid.Row="1"
                              Background="#3C3C3C"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Height="5" ResizeDirection="Rows"
                              AutomationProperties.Name="Response panel height adjuster" />

                <!-- ── Inline response panel ──────────────────────────── -->
                <Grid Grid.Row="2" Background="#1A1A1A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Status header -->
                        <RowDefinition Height="*"    />  <!-- Body area     -->
                        <RowDefinition Height="Auto" />  <!-- Action bar    -->
                    </Grid.RowDefinitions>

                    <!-- Status header — visible after first response -->
                    <Border Grid.Row="0"
                            Background="#252526" Padding="14,8"
                            BorderBrush="#3C3C3C" BorderThickness="0,1,0,1"
                            Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="Response status summary">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Status " Foreground="#888" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ResponseStatusCode}"
                                       FontWeight="Bold" FontSize="15"
                                       Foreground="{Binding ResponseStatusCode, Converter={StaticResource StatusColorConverter}}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="HTTP status code" />
                            <TextBlock Text=" " />
                            <TextBlock Text="{Binding ResponseStatusDesc}"
                                       FontSize="13"
                                       Foreground="{Binding ResponseStatusCode, Converter={StaticResource StatusColorConverter}}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="HTTP status description" />
                            <TextBlock Text="   ·   " Foreground="#444" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ResponseTimeMs, StringFormat='{}{0} ms'}"
                                       Foreground="White" FontWeight="Bold" VerticalAlignment="Center"
                                       AutomationProperties.Name="Response time" />
                            <TextBlock Text="   ·   " Foreground="#444" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ResponseFormattedSize}"
                                       Foreground="White" FontWeight="Bold" VerticalAlignment="Center"
                                       AutomationProperties.Name="Response size" />
                        </WrapPanel>
                    </Border>

                    <!-- Placeholder shown when no response yet -->
                    <TextBlock Grid.Row="1"
                               Text="Hit Send to see the response"
                               Foreground="#3A3A3A" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibilityConverter},
                                            ConverterParameter=invert}" />

                    <!-- Response body / headers / cookies tabs -->
                    <TabControl Grid.Row="1"
                                Background="Transparent" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                                Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="Response content tabs"
                                AutomationProperties.LiveSetting="Polite">

                        <TabItem Header="Body" AutomationProperties.Name="Response body tab">
                            <TextBox Text="{Binding ResponseBodyText, Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     Background="#1A1A1A" Foreground="#D4D4D4" CaretBrush="White"
                                     BorderThickness="0" Padding="10"
                                     FontFamily="Consolas" FontSize="13"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Response body content"
                                     AutomationProperties.HelpText="Read-only. Ctrl+A selects all." />
                        </TabItem>

                        <TabItem Header="Headers" AutomationProperties.Name="Response headers tab">
                            <TextBox Text="{Binding ResponseHeadersText, Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     Background="#1A1A1A" Foreground="#D4D4D4" CaretBrush="White"
                                     BorderThickness="0" Padding="10"
                                     FontFamily="Consolas" FontSize="13"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Response headers" />
                        </TabItem>

                        <TabItem Header="Cookies" AutomationProperties.Name="Response cookies tab">
                            <TextBox Text="{Binding ResponseCookiesText, Mode=OneWay}"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     Background="#1A1A1A" Foreground="#D4D4D4" CaretBrush="White"
                                     BorderThickness="0" Padding="10"
                                     FontFamily="Consolas" FontSize="13"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Response cookies" />
                        </TabItem>
                    </TabControl>

                    <!-- Response action bar: Copy · Full View · Clear -->
                    <Border Grid.Row="2"
                            Background="#252526" Padding="10,7"
                            BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                            Visibility="{Binding HasResponse, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <TextBlock Text="Tip: Ctrl+A to select all · Ctrl+C to copy selection"
                                       Foreground="#555" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Clear"
                                        Command="{Binding ClearResponseCommand}"
                                        Height="30" Padding="12,4" Margin="0,0,6,0"
                                        Background="#3C3C3C" Foreground="#888"
                                        FontSize="12" BorderThickness="0"
                                        ToolTip="Clear the response panel"
                                        AutomationProperties.Name="Clear response panel" />
                                <Button Content="Copy Body"
                                        Command="{Binding CopyResponseBodyCommand}"
                                        Height="30" Padding="14,4" Margin="0,0,6,0"
                                        Background="#3C3C3C" Foreground="White"
                                        FontSize="12" BorderThickness="0"
                                        ToolTip="Copy response body to clipboard"
                                        AutomationProperties.Name="Copy response body to clipboard" />
                                <Button Content="⤢  Full View"
                                        Command="{Binding ViewResponseDetailCommand}"
                                        Height="30" Padding="14,4"
                                        Background="#007ACC" Foreground="White"
                                        FontSize="12" FontWeight="Bold" BorderThickness="0"
                                        ToolTip="Open response in maximized window"
                                        AutomationProperties.Name="Open response in full-screen window" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid><!-- end right pane -->
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="2"
                   Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#CCCCCC" FontSize="12" Padding="5,0"
                           AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
