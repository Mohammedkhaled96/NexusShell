<Window x:Class="NexusShell.App.Views.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SupportViewModel, IsDesignTimeCreatable=False}"
        Title="Contact Support" Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White"
        ResizeMode="NoResize"
        AutomationProperties.Name="Support Form Window">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Contact Support" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Name -->
        <Label Grid.Row="1" Content="_Full Name:" Target="{Binding ElementName=NameBox}" Foreground="White"/>
        <TextBox x:Name="NameBox" Grid.Row="2" 
                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,15" Padding="5"
                 AutomationProperties.Name="Full Name Input"/>

        <!-- Message -->
        <Label Grid.Row="3" Content="_Message:" Target="{Binding ElementName=MessageBox}" Foreground="White" VerticalAlignment="Top"/>
        <TextBox x:Name="MessageBox" Grid.Row="4" 
                 Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,15" Padding="5"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Message Input"/>

        <!-- Attachments Section -->
        <GroupBox Grid.Row="5" Header="Screenshots" Foreground="White" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Attach _Files..." 
                            Command="{Binding AttachCommand}" 
                            Width="100" Height="25" Margin="0,0,10,0"
                            AutomationProperties.Name="Attach Screenshots Button"/>
                    
                    <Button Content="C_lear All" 
                            Command="{Binding ClearAttachmentsCommand}" 
                            Width="80" Height="25"
                            AutomationProperties.Name="Clear Attachments Button">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Attachments}" 
                         Height="80" 
                         Background="#2D2D2D" 
                         BorderThickness="1"
                         BorderBrush="#444"
                         Foreground="#CCCCCC"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="List of selected attachments">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,5,0" Foreground="#AAAAAA"/>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </GroupBox>

        <!-- Footer -->
        <StackPanel Grid.Row="6" Orientation="Vertical">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Yellow" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Submit Request" 
                        Command="{Binding SubmitCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="120" Height="30" 
                        IsDefault="True"
                        AutomationProperties.Name="Submit Button"/>
                <Button Content="_Cancel" 
                        IsCancel="True" 
                        Click="CancelButton_Click"
                        Width="80" Height="30" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>