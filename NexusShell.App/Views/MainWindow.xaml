<Window x:Class="NexusShell.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        xmlns:views="clr-namespace:NexusShell.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Welcome to NexusShell - Professional Terminal Environment" Height="600" Width="800"
        Background="{Binding BackgroundColor}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{Binding FontFamily}"
        FontSize="{Binding FontSize}"
        FocusManager.FocusedElement="{Binding ElementName=CommandInput}">

    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding AddTabCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenScriptCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearTerminalCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshTerminalCommand}" />
        <KeyBinding Key="F1" Command="{Binding ViewHelpCommand}"/>
        <KeyBinding Key="F2" Command="{Binding OpenSettingsCommand}"/>
    </Window.InputBindings>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Off-screen assertive live region. The "read screen" shortcut (Ctrl+Shift+R)
             sets this TextBlock's text and raises LiveRegionChanged so screen readers
             (NVDA/JAWS/Narrator) speak it on demand — the same mechanism the overlay uses
             on open, which is more reliable than UIA notification events. -->
        <TextBlock x:Name="ScreenReaderAnnouncer" Grid.Row="0"
                   AutomationProperties.LiveSetting="Assertive"
                   Focusable="False" IsHitTestVisible="False"
                   Width="1" Height="1" Opacity="0"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />

        <Menu Grid.Row="0" KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Script..." Command="{Binding OpenScriptCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Clear Terminal" Command="{Binding ClearTerminalCommand}" InputGestureText="Ctrl+L" />
                <MenuItem Header="{Binding RunOrStopHeader}"
                          Command="{Binding RunOrStopCommand}"
                          AutomationProperties.Name="{Binding RunOrStopHeader}"
                          InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Export _Command History..." Command="{Binding ExportCommandHistoryCommand}" />
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_General" Command="{Binding OpenSettingsCommand}" CommandParameter="General" InputGestureText="F2" />
                <MenuItem Header="_Appearance" Command="{Binding OpenSettingsCommand}" CommandParameter="Appearance" />
                <MenuItem Header="_Integration" Command="{Binding OpenSettingsCommand}" CommandParameter="Integration" />
                <MenuItem Header="_AI Settings" Command="{Binding OpenSettingsCommand}" CommandParameter="AI" />
            </MenuItem>
            <MenuItem Header="_Managers" AutomationProperties.Name="Managers">
                <MenuItem Header="_Flows (Install CLIs)..."
                          Command="{Binding OpenFlowsManagerCommand}"
                          AutomationProperties.Name="Open Flows manager to install or uninstall CLIs"/>
                <Separator />
                <MenuItem Header="_Shortcut Manager"
                          Command="{Binding OpenShortcutManagerCommand}"
                          AutomationProperties.Name="Open Shortcut Manager"/>
                <MenuItem Header="S_nippet Manager"
                          Command="{Binding OpenSnippetManagerCommand}"
                          AutomationProperties.Name="Open Snippet Manager"/>
                <MenuItem Header="_Alias Manager"
                          Command="{Binding OpenAliasManagerCommand}"
                          AutomationProperties.Name="Open Alias Manager"/>
                <MenuItem Header="_Theme Manager"
                          Command="{Binding OpenThemeManagerCommand}"
                          AutomationProperties.Name="Open Theme Manager"/>
                <Separator />
                <MenuItem Header="S_SH Manager"
                          Command="{Binding OpenSSHManagerCommand}"
                          AutomationProperties.Name="Open SSH Connection Manager"/>
                <MenuItem Header="_Environment Variables"
                          Command="{Binding OpenEnvEditorCommand}"
                          AutomationProperties.Name="Open Environment Variable Manager"/>
                <Separator />
                <MenuItem Header="API _Tester"
                          Command="{Binding OpenApiTesterCommand}"
                          AutomationProperties.Name="Open API Testing Module"/>
            </MenuItem>
            <MenuItem Header="S_hell" ItemsSource="{Binding Profiles}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="Command" Value="{Binding DataContext.AddTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="_AI" AutomationProperties.Name="AI Assistance">
                <MenuItem Header="_Ask AI for Command"
                          Command="{Binding AskAICommand}"
                          AutomationProperties.Name="Ask AI for Command" />
                <Separator />
                <MenuItem Header="_Explain Output"
                          AutomationProperties.Name="Explain Output submenu">
                    <MenuItem Header="_All Output"
                              Command="{Binding ExplainAllOutputCommand}"
                              AutomationProperties.Name="Explain all terminal output" />
                    <MenuItem Header="_Latest Output"
                              Command="{Binding ExplainLatestOutputCommand}"
                              AutomationProperties.Name="Explain latest terminal output" />
                </MenuItem>
                <MenuItem Header="_Summarize Output"
                          AutomationProperties.Name="Summarize Output submenu">
                    <MenuItem Header="_All Output"
                              Command="{Binding SummarizeAllOutputCommand}"
                              AutomationProperties.Name="Summarize all terminal output" />
                    <MenuItem Header="_Latest Output"
                              Command="{Binding SummarizeLatestOutputCommand}"
                              AutomationProperties.Name="Summarize latest terminal output" />
                </MenuItem>
                <MenuItem Header="C_lean Output"
                          AutomationProperties.Name="Clean Output submenu">
                    <MenuItem Header="_Clean Output"
                              Command="{Binding CleanAllOutputCommand}"
                              AutomationProperties.Name="Clean all terminal output" />
                    <MenuItem Header="_Clean Latest Output"
                              Command="{Binding CleanLatestOutputCommand}"
                              AutomationProperties.Name="Clean latest terminal output" />
                </MenuItem>
                <Separator />
                <MenuItem Header="C_hat About Output"
                          AutomationProperties.Name="Chat About Output submenu">
                    <MenuItem Header="_All Output"
                              Command="{Binding ChatAboutAllOutputCommand}"
                              AutomationProperties.Name="Open NexusAI Chat about all terminal output" />
                    <MenuItem Header="_Latest Output"
                              Command="{Binding ChatAboutLatestOutputCommand}"
                              AutomationProperties.Name="Open NexusAI Chat about latest terminal output" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Open _Chat"
                          Command="{Binding OpenAIChatCommand}"
                          AutomationProperties.Name="Open NexusAI Chat window" />
            </MenuItem>
            <MenuItem Header="_View" AutomationProperties.Name="View Options">
                <MenuItem Header="_Find..." Command="{Binding OpenSearchCommand}" InputGestureText="Ctrl+F" AutomationProperties.Name="Find in Output" />
                <MenuItem Header="_Always on Top" IsCheckable="True" IsChecked="{Binding IsAlwaysOnTop}" AutomationProperties.Name="Toggle Always on Top" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_View Help" Command="{Binding ViewHelpCommand}" InputGestureText="F1" />
                <MenuItem Header="_Check for Updates..." Command="{Binding CheckForUpdatesCommand}" />
                <MenuItem Header="_Support" Command="{Binding OpenSupportCommand}" />
                <MenuItem Header="Go to _GitHub" Command="{Binding GoToGitHubCommand}" />
                <Separator />
                <MenuItem Header="_About NexusShell" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <DataTemplate DataType="{x:Type viewModels:TerminalTabViewModel}">
                    <views:TerminalView />
                </DataTemplate>
            </Grid.Resources>

            <!-- Single View Content (Tabs hidden) with Interactive Screen overlay -->
            <Grid Grid.Row="0">
                <!-- Terminal output area (always running, just visually covered) -->
                <ContentControl x:Name="TerminalHost"
                                Content="{Binding SelectedTab}"
                                Focusable="False"/>

                <!-- Interactive Screen overlay: sits above the terminal.
                     Shown/hidden exclusively by InteractiveScreenViewModel.IsVisible.
                     ConPTY pipeline continues uninterrupted beneath it. -->

            </Grid>

            <!-- Command Input Area -->
            <Grid Grid.Row="1" Background="#2D2D2D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text=">"
                           Foreground="#00DD00"
                           FontWeight="Bold"
                           VerticalAlignment="Top" 
                           Margin="10,5,5,0"/>

                <TextBox x:Name="CommandInput"
                         Grid.Column="1"
                         Text="{Binding CurrentCommand, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         Foreground="{Binding TextColor}"
                         BorderThickness="0"
                         Padding="5"
                         CaretBrush="{Binding TextColor}"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         PreviewTextInput="CommandInput_PreviewTextInput"
                         TextChanged="CommandInput_TextChanged"
                         AutomationProperties.Name="Command Input"
                         AutomationProperties.HelpText="Type commands here. Press Tab or Enter to accept suggestions.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Native UI Automation CheckBox Proxy for TUI items -->
                <CheckBox x:Name="TuiSelectionProxy"
                          Grid.Column="1"
                          Width="0" Height="0" Opacity="0"
                          Focusable="False" IsHitTestVisible="False"
                          AutomationProperties.LiveSetting="Assertive" />

                <Popup x:Name="SuggestionPopup"
                       IsOpen="{Binding IsSuggestionsOpen}" 
                       PlacementTarget="{Binding ElementName=CommandInput}" 
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Slide">
                    <Border Background="#252526" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="0">
                        <ListBox x:Name="SuggestionList"
                                 ItemsSource="{Binding Suggestions}" 
                                 SelectedItem="{Binding SelectedSuggestion}"
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 Foreground="#CCCCCC"
                                 MaxHeight="220" 
                                 Width="{Binding ActualWidth, ElementName=CommandInput}"
                                 Focusable="True"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 SelectionChanged="SuggestionList_SelectionChanged"
                                 PreviewKeyDown="SuggestionList_PreviewKeyDown"
                                 AutomationProperties.Name="Command Suggestions"
                                 AutomationProperties.HelpText="Use Arrow Keys to navigate, Enter to select, Escape to cancel.">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding ListItemText}"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="SuggestionList_MouseLeftButtonUp"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ListItemText}" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding ResultType}" Foreground="#888888" FontSize="11" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</Window>
