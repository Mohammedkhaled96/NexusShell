<Window x:Class="NexusShell.App.Views.AddEditShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut Editor" Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White"
        ResizeMode="NoResize"
        AutomationProperties.Name="Shortcut Editor Window">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Command Selection -->
        <Label Grid.Row="0" Grid.Column="0" Content="_Command:" Target="{Binding ElementName=CommandCombo}" Foreground="White"/>
        <ComboBox x:Name="CommandCombo"
                  Grid.Row="0" Grid.Column="1" 
                  ItemsSource="{Binding AvailableCommands}" 
                  SelectedItem="{Binding SelectedCommand}"
                  Margin="0,0,0,15"
                  Padding="5"
                  AutomationProperties.Name="Select Command"
                  AutomationProperties.HelpText="Choose the command to assign a shortcut to."/>

        <!-- Key Input (Captures KeyDown) -->
        <Label Grid.Row="1" Grid.Column="0" Content="_Key:" Target="{Binding ElementName=KeyInputBox}" Foreground="White"/>
        <TextBox x:Name="KeyInputBox"
                 Grid.Row="1" Grid.Column="1" 
                 Text="{Binding KeyDisplayString, Mode=OneWay}"
                 IsReadOnly="True"
                 PreviewKeyDown="KeyInputBox_PreviewKeyDown"
                 PreviewKeyUp="KeyInputBox_PreviewKeyUp"
                 Margin="0,0,0,15"
                 Padding="5"
                 Background="#2D2D2D"
                 Foreground="White"
                 AutomationProperties.Name="Shortcut Key Input"
                 AutomationProperties.HelpText="Press any key combination to assign it."
                 AutomationProperties.LiveSetting="Polite"/>

        <!-- Status/Error Message -->
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" 
                   Text="{Binding StatusMessage}" 
                   Foreground="Yellow" 
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,10"
                   AutomationProperties.LiveSetting="Polite"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_OK" Click="OK_Click" Width="80" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="_Cancel" Click="Cancel_Click" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>