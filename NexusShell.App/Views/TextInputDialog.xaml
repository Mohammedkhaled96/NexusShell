<Window x:Class="NexusShell.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Width="520" SizeToContent="Height"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource Self}}">
    <StackPanel Margin="20">
        <Label x:Name="PromptLabel" Target="{Binding ElementName=InputBox}" Foreground="#CCCCCC" Padding="0,0,0,6"/>
        <TextBox x:Name="InputBox" MaxLength="120" Padding="6,4" FontSize="14"
                 Background="#2D2D2D" Foreground="White" CaretBrush="White" BorderBrush="#555"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="_OK" IsDefault="True" Click="Ok_Click" MinWidth="100" Height="32" Margin="0,0,10,0"
                    Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            <Button Content="_Cancel" IsCancel="True" MinWidth="100" Height="32"
                    Background="#3C3C3C" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
