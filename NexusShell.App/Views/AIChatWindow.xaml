<Window x:Class="NexusShell.App.Views.AIChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AIChatViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}" Height="750" Width="950"
        Background="#121212" Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="CanResize"
        MinWidth="500" MinHeight="400"
        AutomationProperties.Name="{Binding WindowTitle}"
        FocusManager.FocusedElement="{Binding ElementName=MessageInput}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- Chat History / Web View -->
            <RowDefinition Height="Auto"/> <!-- Thinking Status -->
            <RowDefinition Height="Auto"/> <!-- Input Area -->
            <RowDefinition Height="Auto"/> <!-- Global Actions -->
        </Grid.RowDefinitions>

        <!-- Chat Experience Area -->
        <Border Grid.Row="0" Background="#121212" BorderBrush="#333" BorderThickness="1">
            <wv2:WebView2 x:Name="ChatWebView" AutomationProperties.Name="Chat Conversation History" />
        </Border>

        <!-- Thinking Indicator -->
        <TextBlock x:Name="ThinkingIndicator"
                   Grid.Row="1"
                   Text="NexusAI is generating response..."
                   Foreground="#007ACC"
                   FontSize="13"
                   FontWeight="Bold"
                   Margin="5,12,0,12"
                   Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Status Indicator" />

        <!-- User Input Area -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="White" CaretBrush="White"
                         BorderThickness="0"
                         Padding="12"
                         FontSize="16"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinHeight="80" MaxHeight="200"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="MessageInput_PreviewKeyDown"
                         AutomationProperties.Name="Chat Message Input"
                         AutomationProperties.HelpText="Type your question for NexusAI. Press Enter to send, or Shift+Enter for a new line." />

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="SEND"
                        Command="{Binding SendMessageCommand}"
                        Background="#007ACC" Foreground="White"
                        BorderThickness="0"
                        Width="120" Height="50" VerticalAlignment="Bottom"
                        Margin="10,0,5,10"
                        Cursor="Hand"
                        FontWeight="Bold"
                        FontSize="14"
                        IsDefault="True"
                        AutomationProperties.Name="Send message button" />
            </Grid>
        </Border>

        <!-- Utility Footer -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear Chat"
                        Command="{Binding ClearChatCommand}"
                        Background="Transparent" Foreground="#999" BorderThickness="0" Margin="0,0,25,0" Cursor="Hand"
                        AutomationProperties.Name="Clear conversation history" />
                <Button Content="Close Chat"
                        Click="CloseButton_Click"
                        Background="Transparent" Foreground="#999" BorderThickness="0" Cursor="Hand"
                        AutomationProperties.Name="Close chat window" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
