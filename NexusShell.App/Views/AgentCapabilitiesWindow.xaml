<Window x:Class="NexusShell.App.Views.AgentCapabilitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NexusShell.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:AgentWorkspaceViewModel, IsDesignTimeCreatable=False}"
        Title="Tools, skills and MCP servers" Height="620" Width="760"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="480" MinHeight="400"
        AutomationProperties.Name="Tools, skills and MCP servers">

    <Window.Resources>
        <DataTemplate x:Key="CapabilityTemplate">
            <!-- TextBlock content: a plain string would turn the first "_" of names such as
                 list_directory into an access key and drop it from the text and the spoken name. -->
            <CheckBox IsChecked="{Binding IsEnabled}"
                      Foreground="#E0E0E0" Margin="4,4,4,4" FontSize="13"
                      ToolTip="{Binding Description}"
                      AutomationProperties.Name="{Binding AutomationName}"
                      AutomationProperties.HelpText="{Binding Description}">
                <TextBlock Text="{Binding Label}" />
            </CheckBox>
        </DataTemplate>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#CCCCCC" FontSize="13"
                   Text="Choose what the agent may use in this chat. Unchecked items are not offered to the agent at all. Tools that change files or run commands still ask you before they run, unless you chose otherwise in Permissions." />

        <TabControl x:Name="Tabs" Grid.Row="1" Background="#252526" BorderBrush="#444"
                    AutomationProperties.Name="Capability types">
            <TabItem x:Name="ToolsTab" Header="_Tools" AutomationProperties.Name="Tools">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Turn all tools on" Click="AllOn_Click" Tag="tools" Style="{StaticResource DialogButton}" MinWidth="140"/>
                        <Button Content="Turn all tools off" Click="AllOff_Click" Tag="tools" Style="{StaticResource DialogButton}" MinWidth="140"/>
                    </StackPanel>
                    <TextBlock x:Name="NoTools" DockPanel.Dock="Top" Text="No tools are available." Visibility="Collapsed" Foreground="#AAAAAA"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource CapabilityTemplate}"
                                      IsTabStop="False" AutomationProperties.Name="Tools list"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="SkillsTab" Header="_Skills" AutomationProperties.Name="Skills">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Turn all skills on" Click="AllOn_Click" Tag="skills" Style="{StaticResource DialogButton}" MinWidth="140"/>
                        <Button Content="Turn all skills off" Click="AllOff_Click" Tag="skills" Style="{StaticResource DialogButton}" MinWidth="140"/>
                    </StackPanel>
                    <TextBlock x:Name="NoSkills" DockPanel.Dock="Top" TextWrapping="Wrap" Visibility="Collapsed" Foreground="#AAAAAA"
                               Text="No skills found. Add a skill as a folder with a SKILL.md file in %AppData%\NexusShell\agent\skills."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource CapabilityTemplate}"
                                      IsTabStop="False" AutomationProperties.Name="Skills list"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="McpTab" Header="_MCP servers" AutomationProperties.Name="MCP servers">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Turn all MCP servers on" Click="AllOn_Click" Tag="mcp" Style="{StaticResource DialogButton}" MinWidth="170"/>
                        <Button Content="Turn all MCP servers off" Click="AllOff_Click" Tag="mcp" Style="{StaticResource DialogButton}" MinWidth="170"/>
                    </StackPanel>
                    <TextBlock x:Name="NoMcp" DockPanel.Dock="Top" TextWrapping="Wrap" Visibility="Collapsed" Foreground="#AAAAAA"
                               Text="No MCP servers configured. Add them to %AppData%\NexusShell\agent\mcp.json (same format as Claude Desktop), then press Refresh in the chat window."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding McpServers}" ItemTemplate="{StaticResource CapabilityTemplate}"
                                      IsTabStop="False" AutomationProperties.Name="MCP servers list"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_OK" IsDefault="True" Click="Ok_Click" Style="{StaticResource DialogButton}" Background="#007ACC" FontWeight="SemiBold"
                    AutomationProperties.Name="OK, apply these choices"/>
            <Button Content="_Cancel" IsCancel="True" Style="{StaticResource DialogButton}" Margin="0"
                    AutomationProperties.Name="Cancel, keep previous choices"/>
        </StackPanel>
    </Grid>
</Window>
