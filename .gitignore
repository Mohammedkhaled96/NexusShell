# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
output/
artifacts/
*.nupkg

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.user
*.suo
*.rsuser
*.userprefs
*.sln.docstates

# Test results
[Tt]est[Rr]esult*/
*.trx
coverage*.xml

# Installers are distributed via GitHub Releases
*.exe
*.msi
*.zip

# Local secrets & runtime data (settings with real API keys live in %AppData%)
.env
*.local.json
*.pfx
*.snk
logs/

# OS clutter (created automatically by Explorer / Finder)
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Logs and build diagnostics kept outside logs/
*.log
*.binlog

# Crash dumps: large, machine-specific, and may contain in-memory secrets
*.dmp
*.mdmp

# Local Docker overrides (personal paths / credentials by design)
docker-compose.override.yml

# Legacy NuGet restore folder
packages/

# ReSharper / Rider per-user caches
_ReSharper*/
*.DotSettings.user

# Visual Studio coverage formats not matched by coverage*.xml
*.coverage
*.coveragexml
